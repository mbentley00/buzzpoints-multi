{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "(?:www\\.)?(?:buzzpoints\\.buzz|quizbowlbuzzpoints\\.com)" }],
      "destination": "https://www.buzzpoints.org/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(?:www\\.)?(?:buzzpoints\\.buzz|quizbowlbuzzpoints\\.com)" }],
      "destination": "https://www.buzzpoints.org/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin?op=publish-reminders",
      "schedule": "0 15 * * *"
    }
  ],
  "functions": {
    "api/admin.ts": {
      "includeFiles": "api/_fills/**"
    }
  }
}
