{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/admin?op=publish-reminders",
      "schedule": "0 15 * * *"
    }
  ],
  "functions": {
    "api/admin.ts": {
      "includeFiles": "api/_fills/**"
    }
  }
}
